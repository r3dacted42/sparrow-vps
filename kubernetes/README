# kubernetes manifests

use the following command to create the secrets manifest:
```bash
cp sparrow-secrets.template.yml sparrow-secrets.yml
```
make sure you update the `"placeholder"` values in `sparrow-secrets.yml` with the correct credentials and apply/re-apply the secret after updates.

for the supabase db, use the following to add the required tables to the project:
```sql
--
-- Name: projects; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.projects (
    id bigint NOT NULL,
    "user" text,
    repourl text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    pathname text
);


ALTER TABLE public.projects OWNER TO postgres;

--
-- Name: projects_id_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.projects ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.projects_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: users_superset; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.users_superset (
    id bigint NOT NULL,
    github_id bigint NOT NULL,
    username text NOT NULL,
    name text,
    email text,
    avatar_url text,
    html_url text,
    access_token text NOT NULL,
    modified_date timestamp with time zone,
    created_at timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.users_superset OWNER TO postgres;

--
-- Name: users_superset_id_seq; Type: SEQUENCE; Schema: public; Owner: postgres
--

ALTER TABLE public.users_superset ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.users_superset_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);
```
